[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "description": "Create a proposal DRAFT on the marketplace. dry_run=True sends nothing and returns the exact payload, the\n    Connects it will cost (with any policy surcharge) and policy warnings. Nothing is submitted by this tool.",
  "inputSchema": {
   "properties": {
    "approval_token": {
     "anyOf": [
      {
       "maxLength": 200,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Signed token from the user's approval in the GigBid UI. Required unless dry_run is true.",
     "title": "Approval Token"
    },
    "bid_amount": {
     "exclusiveMinimum": 0,
     "maximum": 100000,
     "title": "Bid Amount",
     "type": "number"
    },
    "bid_type": {
     "enum": [
      "fixed",
      "hourly"
     ],
     "title": "Bid Type",
     "type": "string"
    },
    "cover_letter": {
     "maxLength": 5000,
     "minLength": 50,
     "title": "Cover Letter",
     "type": "string"
    },
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Idempotency key: the same key never submits or spends twice",
     "pattern": "^[A-Za-z0-9:_.-]{8,128}$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "description": "Marketplace job id",
     "pattern": "^[\\w.~-]{3,80}$",
     "title": "Job Id",
     "type": "string"
    },
    "screening_answers": {
     "default": [],
     "items": {
      "maxLength": 1500,
      "type": "string"
     },
     "maxItems": 10,
     "title": "Screening Answers",
     "type": "array"
    }
   },
   "required": [
    "job_id",
    "cover_letter",
    "bid_amount",
    "bid_type",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "name": "create_proposal_draft",
  "outputSchema": {
   "properties": {
    "connects_balance_after": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Balance After"
    },
    "connects_cost": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Connects Cost"
    },
    "connects_surcharges": {
     "items": {
      "type": "string"
     },
     "title": "Connects Surcharges",
     "type": "array"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "policy_warnings": {
     "items": {
      "type": "string"
     },
     "title": "Policy Warnings",
     "type": "array"
    },
    "proposal_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Proposal Id"
    },
    "status": {
     "title": "Status",
     "type": "string"
    },
    "would_send": {
     "anyOf": [
      {
       "additionalProperties": true,
       "type": "object"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Exactly what would be sent (dry_run only)",
     "title": "Would Send"
    }
   },
   "required": [
    "dry_run",
    "status"
   ],
   "title": "DraftResult",
   "type": "object"
  }
 },
