  "description": "Full text of one case study (id like `case:helpdesk-rag` or just `helpdesk-rag`) plus related evidence ids.",
  "inputSchema": {
   "properties": {
    "case_id": {
     "maxLength": 100,
     "minLength": 2,
     "title": "Case Id",
     "type": "string"
    }
   },
   "required": [
    "case_id"
   ],
   "title": "get_case_studyArguments",
   "type": "object"
  },
  "name": "get_case_study",
  "outputSchema": {
   "properties": {
    "client_industry": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Client Industry"
    },
    "date": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Date"
    },
    "id": {
     "title": "Id",
     "type": "string"
    },
    "project": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Project"
    },
    "related": {
     "description": "Other evidence ids for the same project",
     "items": {
      "type": "string"
     },
     "title": "Related",
     "type": "array"
    },
    "skills": {
     "items": {
      "type": "string"
     },
     "title": "Skills",
     "type": "array"
    },
    "text": {
     "title": "Text",
     "type": "string"
    },
    "title": {
     "title": "Title",
     "type": "string"
    }
   },
   "required": [
    "id",
    "title",
    "project",
    "client_industry",
    "date",
    "skills",
    "text"
   ],
   "title": "CaseStudy",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Every skill the portfolio has evidence for, with how many evidence items and which projects show it.",
  "inputSchema": {
   "properties": {},
   "title": "list_skillsArguments",
   "type": "object"
  },
  "name": "list_skills",
  "outputSchema": {
   "$defs": {
    "SkillCount": {
     "properties": {
      "evidence_count": {
       "title": "Evidence Count",
       "type": "integer"
      },
      "projects": {
       "items": {
        "type": "string"
       },
       "title": "Projects",
       "type": "array"
      },
      "skill": {
       "title": "Skill",
       "type": "string"
      }
     },
     "required": [
      "skill",
      "evidence_count",
      "projects"
     ],
     "title": "SkillCount",
     "type": "object"
    }
   },
   "properties": {
    "corpus": {
     "title": "Corpus",
     "type": "string"
    },
    "skills": {
     "items": {
      "$ref": "#/$defs/SkillCount"
     },
     "title": "Skills",
     "type": "array"
    }
   },
   "required": [
    "corpus",
    "skills"
   ],
   "title": "SkillList",
   "type": "object"
  }
 },
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Find portfolio evidence (case studies, repos/code, reviews, CV) that proves one requirement. Each item has\n    an id to cite, its type, source, date and, for proposals, the outcome.",
  "inputSchema": {
   "$defs": {
    "EvidenceFilters": {
     "properties": {
      "outcome": {
       "anyOf": [
        {
         "enum": [
          "won",
          "replied",
          "ignored"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Only for proposals",
       "title": "Outcome"
      },
      "project": {
       "anyOf": [
        {
         "maxLength": 80,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Project"
      },
      "since_year": {
       "anyOf": [
        {
         "maximum": 2100,
         "minimum": 1990,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Since Year"
      },
      "types": {
       "anyOf": [
        {
         "items": {
          "enum": [
           "cv",
           "case_study",
           "readme",
           "code",
           "review",
           "proposal"
          ],
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "Restrict to these evidence types",
       "title": "Types"
      }
     },
     "title": "EvidenceFilters",
     "type": "object"
    }
   },
   "properties": {
    "filters": {
     "anyOf": [
      {
       "$ref": "#/$defs/EvidenceFilters"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "k": {
     "default": 5,
     "maximum": 20,
     "minimum": 1,
     "title": "K",
     "type": "integer"
    },
    "requirement": {
     "maxLength": 500,
     "minLength": 3,
     "title": "Requirement",
     "type": "string"
    }
   },
   "required": [
    "requirement"
   ],
   "title": "search_evidenceArguments",
   "type": "object"
  },
  "name": "search_evidence",
  "outputSchema": {
   "$defs": {
    "EvidenceItem": {
     "properties": {
      "client_industry": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Client Industry"
      },
      "date": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Date"
      },
      "id": {
       "description": "Evidence id to cite, e.g. case:helpdesk-rag or repo:trackline",
       "title": "Id",
       "type": "string"
      },
      "outcome": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Outcome"
      },
      "project": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Project"
      },
      "score": {
       "title": "Score",
       "type": "number"
      },
      "skills": {
       "items": {
        "type": "string"
       },
       "title": "Skills",
       "type": "array"
      },
      "snippet": {
       "title": "Snippet",
       "type": "string"
      },
      "source": {
       "title": "Source",
       "type": "string"
      },
      "title": {
       "title": "Title",
       "type": "string"
      },
      "type": {
       "title": "Type",
       "type": "string"
      }
     },
     "required": [
      "id",
      "type",
      "source",
      "title",
      "snippet",
      "score"
     ],
     "title": "EvidenceItem",
     "type": "object"
    }
   },
   "properties": {
    "items": {
     "items": {
      "$ref": "#/$defs/EvidenceItem"
     },
     "title": "Items",
     "type": "array"
    },
    "requirement": {
     "title": "Requirement",
     "type": "string"
    },
    "variant": {
     "title": "Variant",
     "type": "string"
    }
   },
   "required": [
    "requirement",
    "items",
    "variant"
   ],
   "title": "EvidenceResult",
   "type": "object"
  }
 }
]