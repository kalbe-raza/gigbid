# Copy to .env and fill in. Never commit .env. Every variable GigBid reads is listed here.
APP_ENV=development
APP_SECRET_KEY=change-me-long-random
TOKEN_ENCRYPTION_KEY=change-me-long-random
APPROVAL_SIGNING_KEY=change-me-long-random
COOKIE_SECURE=0
CORS_ORIGINS=http://localhost:3000

# storage
DATABASE_URL=postgresql://gigbid:gigbid@localhost:55432/gigbid
POSTGRES_PASSWORD=gigbid
REDIS_URL=redis://localhost:56379/0
QDRANT_URL=http://localhost:56333
QDRANT_PATH=
UPLOADS_DIR=

# marketplace
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_API_TOKEN=gs-dev-token
GIGSIM_DEMO_TOKEN=gs-dev-token
GIGSIM_TOKENS=gs-dev-token:demo,gs-eval-token:eval
GIGSIM_ADMIN_TOKEN=change-me
GIGSIM_CLIENT_MODE=rules
GIGSIM_LLM_API_KEY=
UPWORK_CLIENT_ID=

# MCP servers (service-to-service bearer token)
MCP_SERVICE_TOKEN=change-me
MCP_SERVICE_TOKENS=change-me
PORTFOLIO_MCP_URL=http://localhost:8101/mcp
MARKETPLACE_MCP_URL=http://localhost:8102/mcp
WORKSPACE_MCP_URL=http://localhost:8103/mcp

# models (open profile: open-weight models via hosted providers or local Ollama)
MODEL_PROFILE=open
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
RAG_VARIANT=

# tracing (self-hosted Arize Phoenix)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:56006
PHOENIX_PUBLIC_URL=http://localhost:56006
TRACING_DISABLED=0

# reviewer accounts created at startup: email:password:persona;...
REVIEWER_ACCOUNTS=reviewer@example.com:change-me:fullstack
